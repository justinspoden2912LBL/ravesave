# Public Supabase client configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public identifier used only to compare the authenticated user ID in the UI.
# Do not place service-role keys or provider secrets here.
VITE_ADMIN_USER_ID=your-confirmed-supabase-admin-user-id

# Server-only values belong in Vercel Environment Variables, never in this file.
# SUPABASE_SERVICE_ROLE_KEY=server-only
